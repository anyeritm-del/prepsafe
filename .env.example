# Copy this file to .env and fill in real values. See README.md for how to
# provision Postgres (Neon via Vercel Storage) and Vercel Blob.

# Pooled connection string (used by the app at runtime, via lib/prisma.ts).
# Neon: the connection string with "-pooler" in the hostname.
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"

# Direct (unpooled) connection string, used only by the Prisma CLI for
# migrations (see prisma.config.ts).
# Neon: the connection string WITHOUT "-pooler" in the hostname.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Auth.js session encryption secret. Generate with: npx auth secret
AUTH_SECRET=""

# Vercel Blob read/write token (Storage tab in the Vercel dashboard).
BLOB_READ_WRITE_TOKEN=""

# Used once by `npx prisma db seed` to create the first Company/Store/admin
# user, since there is no public sign-up page.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_COMPANY_NAME="Nama Company"
SEED_STORE_NAME="Nama Store"
