# Copy this file to .env and fill in real values for local development.
# See README.md for how to provision Postgres and Blob via Vercel Storage.

# --- Postgres (Neon) ---
# When you create a Postgres store in the Vercel dashboard's Storage tab and
# connect it to this project, Vercel automatically adds DATABASE_URL (pooled,
# used at runtime by lib/prisma.ts) and DATABASE_URL_UNPOOLED (direct, used
# only by the Prisma CLI for migrations — see prisma.config.ts) plus several
# other POSTGRES_*/PG* aliases you can ignore.
DATABASE_URL="postgresql://user:password@host-pooler/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# --- Vercel Blob ---
# Connecting a Blob store to this project (Storage tab) adds BLOB_STORE_ID +
# VERCEL_OIDC_TOKEN, which @vercel/blob uses automatically when running on
# Vercel — no token to copy. For LOCAL development only, run `vercel env
# pull` to fetch a short-lived VERCEL_OIDC_TOKEN (it needs periodic re-pull
# since it rotates), or add a static BLOB_READ_WRITE_TOKEN as a fallback.

# --- Auth.js ---
# Session encryption secret. Generate with: npx auth secret
AUTH_SECRET=""

# --- Seed data ---
# Used once by `npx prisma db seed` to create the first Company/Store/admin
# user, since there is no public sign-up page.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_COMPANY_NAME="Nama Company"
SEED_STORE_NAME="Nama Store"
